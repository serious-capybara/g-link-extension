[Desktop Entry]
Type=Application
Name=GLink
Exec=gapplication launch org.gnome.Shell.Extensions.GLink %U
Terminal=false
NoDisplay=true
Icon=org.gnome.Shell.Extensions.GLink
Categories=Network;
MimeType=x-scheme-handler/sms;x-scheme-handler/tel;
DBusActivatable=true
X-GNOME-UsesNotifications=true

