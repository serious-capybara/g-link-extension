fallback_dir=$HOME/.local/share/gnome-shell/extensions/g-link@glink.org/

if [ ! -f "./g-link-preferences.js" ]; then
    # Try to find home path
    extension_dir="$(dirname "$(realpath "$(command -v "$0")")")"
    # try even harder
    if [ ! -d "$extension_dir" ]; then
        extension_dir="$fallback_dir"
    fi
    cd "$extension_dir" || exit 1
fi
exec /usr/bin/env gjs -m g-link-preferences.js
